+// Slot's callbacks are thread-local. Keep worker PCM bounded and snapshot input
+// on retro_run; never call the frontend audio/input API from the SH4 worker.
+static retro_audio_sample_batch_t slot_frontend_audio = NULL;
+static retro_input_state_t slot_frontend_input = NULL;
+static retro_input_poll_t slot_frontend_poll = NULL;
+static std::mutex slot_pcm_mutex;
+static std::vector<int16_t> slot_pcm;
+static std::atomic<int16_t> slot_buttons[4][16];
+static std::atomic<int16_t> slot_masks[4];
+static std::atomic<int16_t> slot_axes[4][3][16];
+static unsigned slot_overflow_count = 0;
+static std::atomic<bool> slot_stopping{false};
+
+static retro_time_t slot_time_usec()
+{
+    return std::chrono::duration_cast<std::chrono::microseconds>(
+        std::chrono::steady_clock::now().time_since_epoch()).count();
+}
+
+
+static size_t slot_queue_audio(const int16_t *samples, size_t frames)
+{
+    if (!samples || frames == 0) return frames;
+    // RetroRun's frontend audio callback normally provides backpressure. Our
+    // delivery is deferred to retro_run, so pace the SH4 producer independently
+    // of rendering instead of allowing it to run ahead and overflow the queue.
+    if (settings.rend.ThreadedRendering && settings.aica.LimitFPS)
+    {
+        using clock = std::chrono::steady_clock;
+        static thread_local clock::time_point due;
+        auto now = clock::now();
+        if (due == clock::time_point() || now - due > std::chrono::milliseconds(100)) due = now;
+        due += std::chrono::nanoseconds(frames * 1000000000ULL / 44100);
+        std::this_thread::sleep_until(due);
+    }
+    std::lock_guard<std::mutex> lock(slot_pcm_mutex);
+    const size_t limit = 44100 * 2; // one second, no worker wait/deadlock
+    const size_t count = frames * 2;
+    if (count > limit || slot_pcm.size() + count > limit)
+    {
+        slot_pcm.clear();
+        ++slot_overflow_count;
+    }
+    if (count <= limit) slot_pcm.insert(slot_pcm.end(), samples, samples + count);
+    return frames;
+}
+
+static int16_t slot_read_input(unsigned port, unsigned device, unsigned index, unsigned id)
+{
+    if (port >= 4) return 0;
+    if (device == RETRO_DEVICE_JOYPAD)
+    {
+        if (id == RETRO_DEVICE_ID_JOYPAD_MASK) return slot_masks[port].load();
+        return id < 16 ? slot_buttons[port][id].load() : 0;
+    }
+    if (device == RETRO_DEVICE_ANALOG && index < 3 && id < 16)
+        return slot_axes[port][index][id].load();
+    return 0;
+}
+
+static void slot_poll_input() {} // frontend polling happens only in retro_run
+
+static void slot_snapshot_input()
+{
+    if (slot_frontend_poll) slot_frontend_poll();
+    for (unsigned port = 0; port < 4; ++port)
+    {
+        uint16_t mask = 0;
+        for (unsigned id = 0; id < 16; ++id)
+        {
+            int16_t v = slot_frontend_input ? slot_frontend_input(port, RETRO_DEVICE_JOYPAD, 0, id) : 0;
+            slot_buttons[port][id].store(v);
+            if (v) mask |= 1u << id;
+        }
+        slot_masks[port].store((int16_t)mask);
+        for (unsigned index = 0; index < 3; ++index)
+            for (unsigned id = 0; id < 16; ++id)
+                slot_axes[port][index][id].store(slot_frontend_input ? slot_frontend_input(port, RETRO_DEVICE_ANALOG, index, id) : 0);
+    }
+}
+
+static void slot_flush_audio()
+{
+    // Reuse a drain buffer; invoking callbacks while holding the queue mutex
+    // could stall the worker or deadlock frontend teardown.
+    static std::vector<int16_t> drain;
+    unsigned overflow;
+    {
+        std::lock_guard<std::mutex> lock(slot_pcm_mutex);
+        drain.clear();
+        drain.swap(slot_pcm);
+        overflow = slot_overflow_count;
+        slot_overflow_count = 0;
+    }
+    if (slot_frontend_audio && !drain.empty())
+        slot_frontend_audio(drain.data(), drain.size() / 2);
+    drain.clear();
+    if (overflow) fprintf(stderr, "slot: Flycast callback bridge PCM overflow=%u\n", overflow);
+}
