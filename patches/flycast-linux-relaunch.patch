@@ -383,8 +383,14 @@
 	}
 	os_UninstallFaultHandler();
 	
-#if defined(__APPLE__) || (defined(__GNUC__) && defined(__linux__) && !defined(__ANDROID__))
+#if defined(__APPLE__)
 	addrspace::release();
+#elif defined(__GNUC__) && defined(__linux__) && !defined(__ANDROID__)
+	// Linux retains emu/recompiler between retro_init calls (emuInited above).
